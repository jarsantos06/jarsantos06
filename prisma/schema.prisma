// Sistema Operacional — schema base
// Banco: SQLite em dev (sem infra). Migração para PostgreSQL é direta:
// basta trocar provider = "postgresql" e a DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// MÓDULO CADASTROS — cargos e permissões dinâmicas (RBAC dirigido pelo banco)
//
// O CÓDIGO define o catálogo de permissões existentes (src/lib/rbac.ts);
// o BANCO define quais cargos possuem cada permissão — editável na UI.
// ---------------------------------------------------------------------------
model Cargo {
  id        String   @id @default(cuid())
  nome      String   @unique // "Controlador", "Assistente de Logística N1"...
  nivel     Int      @default(0) // ordem de exibição (1 = mais operacional)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissoes CargoPermissao[]
  usuarios   User[]
}

model CargoPermissao {
  id        String @id @default(cuid())
  cargo     Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  cargoId   String
  permissao String // chave do catálogo em src/lib/rbac.ts (ex.: "almoxarifado.ver")

  @@unique([cargoId, permissao])
  @@index([cargoId])
}

model User {
  id        String   @id @default(cuid())
  matricula String   @unique // login (matrícula do funcionário)
  nome      String
  email     String?  @unique
  senhaHash String
  cargo     Cargo?   @relation(fields: [cargoId], references: [id])
  cargoId   String? // nulo = sem cargo definido (sem acesso aos módulos)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações abertas conforme os módulos forem construídos
  movimentacoes MovimentacaoMaterial[] @relation("MovimentacaoUsuario")
  travamentos   Travamento[]           @relation("TravamentoOperador")
  destravamentos Travamento[]          @relation("DestravamentoOperador")
  ocorrencias   Ocorrencia[]           @relation("OcorrenciaSolicitante")
  aprovacoes    Ocorrencia[]           @relation("OcorrenciaAprovador")
  escalas       EscalaFuncionario[]    @relation("EscalaFuncionario")
  escalasCriadas EscalaFuncionario[]   @relation("EscalaCriador")

  @@index([cargoId])
}

// ===========================================================================
// MÓDULO 1 — ALMOXARIFADO
// ===========================================================================
enum CategoriaMaterial {
  USO_DIARIO
  LIMPEZA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model Material {
  id            String            @id @default(cuid())
  codigo        String            @unique
  nome          String
  categoria     CategoriaMaterial
  unidade       String            @default("UN") // UN, CX, L, KG...
  saldo         Int               @default(0)
  estoqueMinimo Int               @default(0)
  ativo         Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  movimentacoes MovimentacaoMaterial[]

  @@index([categoria])
}

model MovimentacaoMaterial {
  id         String           @id @default(cuid())
  material   Material         @relation(fields: [materialId], references: [id])
  materialId String
  tipo       TipoMovimentacao
  quantidade Int
  saldoApos  Int // saldo do material após a movimentação (trilha de auditoria)
  destino    String? // para quem/onde saiu, ou fornecedor na entrada
  observacao String?
  usuario    User             @relation("MovimentacaoUsuario", fields: [usuarioId], references: [id])
  usuarioId  String
  createdAt  DateTime         @default(now())

  @@index([materialId])
  @@index([tipo])
  @@index([createdAt])
}

// ===========================================================================
// MÓDULO 2 — TRAVAMENTO DE CARRETA
// ===========================================================================
enum StatusCarreta {
  TRAVADA
  DESTRAVADA
}

model Travamento {
  id             String        @id @default(cuid())
  placa          String
  ticket         String        @unique
  fotoUrl        String // foto da carreta travada
  status         StatusCarreta @default(TRAVADA)
  observacao     String?

  operador       User          @relation("TravamentoOperador", fields: [operadorId], references: [id])
  operadorId     String
  travadoEm      DateTime      @default(now())

  destravador    User?         @relation("DestravamentoOperador", fields: [destravadorId], references: [id])
  destravadorId  String?
  destravadoEm   DateTime?

  @@index([status])
  @@index([placa])
  @@index([travadoEm])
}

// ===========================================================================
// MÓDULO 3 — OCORRÊNCIAS (FALTAS E ATRASOS)
// ===========================================================================
enum TipoOcorrencia {
  FALTA
  ATRASO
}

enum StatusOcorrencia {
  PENDENTE
  APROVADA
  REPROVADA
}

model Ocorrencia {
  id            String           @id @default(cuid())
  tipo          TipoOcorrencia
  dataOcorrencia DateTime
  motivo        String
  evidenciaUrl  String? // anexo de evidência
  status        StatusOcorrencia @default(PENDENTE)

  solicitante   User             @relation("OcorrenciaSolicitante", fields: [solicitanteId], references: [id])
  solicitanteId String

  aprovador     User?            @relation("OcorrenciaAprovador", fields: [aprovadorId], references: [id])
  aprovadorId   String?
  parecer       String? // observação do gestor na aprovação/reprovação
  decididoEm    DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([solicitanteId])
  @@index([createdAt])
}

// ===========================================================================
// MÓDULO 4 — ESCALA / TURNOS
// ===========================================================================

// Padrão de escala: ciclo de dias trabalhados x folgados (ex.: 2x2, 6x1, 5x2)
model PadraoEscala {
  id           String              @id @default(cuid())
  nome         String              @unique // "2x2", "6x1", "5x2"
  diasTrabalho Int
  diasFolga    Int
  ativo        Boolean             @default(true)
  createdAt    DateTime            @default(now())

  escalas      EscalaFuncionario[]
}

// Turno: faixa de horário (ex.: Diurno 07:00-19:00, Noturno 19:00-07:00)
model Turno {
  id         String              @id @default(cuid())
  nome       String              @unique
  horaInicio String // "07:00"
  horaFim    String // "19:00"
  ativo      Boolean             @default(true)
  createdAt  DateTime            @default(now())

  escalas    EscalaFuncionario[]
}

// Atribuição de escala a um funcionário.
// dataInicio é a ÂNCORA do ciclo: o sistema calcula trabalha/folga a partir dela.
// dataFim nulo = escala padronizada (segue repetindo até uma nova substituí-la).
model EscalaFuncionario {
  id            String       @id @default(cuid())
  funcionario   User         @relation("EscalaFuncionario", fields: [funcionarioId], references: [id])
  funcionarioId String
  padrao        PadraoEscala @relation(fields: [padraoId], references: [id])
  padraoId      String
  turno         Turno        @relation(fields: [turnoId], references: [id])
  turnoId       String
  dataInicio    DateTime // âncora do ciclo
  dataFim       DateTime? // nulo = vigente/padronizada
  observacao    String?

  criadoPor     User         @relation("EscalaCriador", fields: [criadoPorId], references: [id])
  criadoPorId   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([funcionarioId])
  @@index([dataInicio])
}
